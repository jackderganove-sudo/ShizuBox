<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- System installer fallback when Shizuku is not available -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- VirusTotal scan -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App manager: needs to see every installed package. -->
    <!-- Granted to ourselves through Shizuku (appops) for the screen time page. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Shizuku forks (e.g. com.hamondev.shevery) keep this action -->
        <intent>
            <action android:name="moe.shizuku.privileged.api.intent.action.REQUEST_PERMISSION" />
        </intent>
    </queries>

    <application
        android:name=".ShizuBoxApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:directBootAware="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShizuBox">

        <activity
            android:name=".MainActivity"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|keyboard|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".school.BlackActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="de.emil.shizubox.black"
            android:showWhenLocked="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ShizuBox.Black" />

        <activity
            android:name=".school.ExitGuideActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:taskAffinity="de.emil.shizubox.exit"
            android:theme="@style/Theme.ShizuBox" />

        <service
            android:name=".school.SchoolService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the screen black during school mode and detects the power-button exit" />
        </service>

        <service
            android:name=".school.SchoolTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_school"
            android:label="@string/sec_school"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.GamingTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_gaming"
            android:label="@string/gaming"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.AnimationsTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_animation"
            android:label="@string/tile_animations"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.RefreshTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_refresh"
            android:label="@string/cust_refresh"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.StayAwakeTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_coffee"
            android:label="@string/tile_stay_awake"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.BoostTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_boost"
            android:label="@string/vb_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Notification history: records notifications locally (access granted via Shizuku or settings). -->
        <service
            android:name=".notifications.HistoryListener"
            android:exported="true"
            android:label="@string/nh_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Automations: sensors (battery, audio devices, Wi-Fi, foreground app) while rules are on. -->
        <service
            android:name=".automation.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches user-defined automation triggers (charger, headphones, Wi-Fi, opened app) to run the user's rules" />
        </service>

        <receiver
            android:name=".automation.AutomationAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".battery.NightReceiver"
            android:exported="false" />

        <service
            android:name=".tiles.CacheTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_cache"
            android:label="@string/cc_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.ClipboardTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_clipboard"
            android:label="@string/cb_title_short"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Volume boost: keeps the loudness effect on the output mix alive. -->
        <service
            android:name=".system.BoostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Applies a user-enabled loudness boost to all audio output until switched off" />
        </service>

        <receiver
            android:name=".system.StartupReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".tiles.QuickWidget"
            android:exported="true"
            android:label="@string/qa_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_info" />
        </receiver>

        <receiver
            android:name=".schoolstats.SchoolStatsWidget"
            android:exported="true"
            android:label="@string/ss_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_school_stats_info" />
        </receiver>

        <receiver
            android:name=".tiles.QuickWidgetToggleReceiver"
            android:exported="false" />

        <receiver
            android:name=".school.ScheduleAlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".school.ScheduleTimeReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".school.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".school.AutoEndReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".school.AdbExitReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Buttons of the "updates available" notification. -->
        <activity
            android:name=".updates.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="de.emil.shizubox.updateinstall"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name=".updates.UpdateSkipReceiver"
            android:exported="false" />

        <!-- Video downloader: queue runs in this service while the app is closed. -->
        <service
            android:name=".downloader.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".downloader.DownloadResumeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Download with ShizuBox" in the share menu (links from YouTube, browsers, …). -->
        <activity
            android:name=".downloader.DownloadShareActivity"
            android:label="@string/dl_share_label"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="de.emil.shizubox.download"
            android:theme="@style/Theme.ShizuBox">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Universal Installer flow; also offered as "open with" for APK files. -->
        <activity
            android:name=".installer.InstallActivity"
            android:label="@string/installer_label"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="de.emil.shizubox.install"
            android:theme="@style/Theme.ShizuBox">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/vnd.apkm" />
                <data android:mimeType="application/xapk-package-archive" />
                <data android:mimeType="application/x-xapk" />
                <data android:mimeType="application/apks" />
            </intent-filter>
            <!-- File managers (e.g. Files by Google) send bundles as generic/zip types; match by name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-zip" />
                <data android:pathSuffix=".apk" />
                <data android:pathSuffix=".APK" />
                <data android:pathSuffix=".apks" />
                <data android:pathSuffix=".APKS" />
                <data android:pathSuffix=".xapk" />
                <data android:pathSuffix=".XAPK" />
                <data android:pathSuffix=".apkm" />
                <data android:pathSuffix=".APKM" />
                <data android:pathPattern=".*\\.apk" />
                <data android:pathPattern=".*\\.APK" />
                <data android:pathPattern=".*\\.apks" />
                <data android:pathPattern=".*\\.APKS" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\.XAPK" />
                <data android:pathPattern=".*\\.apkm" />
                <data android:pathPattern=".*\\.APKM" />
            </intent-filter>
            <!-- Files by Google sends bundles as octet-stream with an opaque content URI (no file
                 name in the path). Non-package files are forwarded by InstallActivity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Opened by extension without any MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".apk" />
                <data android:pathSuffix=".APK" />
                <data android:pathSuffix=".apks" />
                <data android:pathSuffix=".APKS" />
                <data android:pathSuffix=".xapk" />
                <data android:pathSuffix=".XAPK" />
                <data android:pathSuffix=".apkm" />
                <data android:pathSuffix=".APKM" />
                <data android:pathPattern=".*\\.apk" />
                <data android:pathPattern=".*\\.APK" />
                <data android:pathPattern=".*\\.apks" />
                <data android:pathPattern=".*\\.APKS" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\.XAPK" />
                <data android:pathPattern=".*\\.apkm" />
                <data android:pathPattern=".*\\.APKM" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- WorkManager's foreground service: app updates keep running after leaving ShizuBox. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".updates.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
