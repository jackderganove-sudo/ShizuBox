<?xml version="1.0" encoding="utf-8"?>
<!--
  No automatic Google backup and no device-to-device copy (Daniel's review, 0.11.1): the app data holds
  clipboard and notification history, the privacy log, the school mode snapshot (restoring it on another
  phone would "restore" foreign settings there), the VirusTotal key and the trash index. ShizuBox has its own
  backup (Settings → Backup) that contains only settings. allowBackup="false" alone no longer stops the
  device-to-device transfer since Android 12, hence every domain is excluded here as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
