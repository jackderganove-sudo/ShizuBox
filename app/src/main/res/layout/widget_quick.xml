<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/w_gaming"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="2dp">

        <ImageView
            android:id="@+id/w_gaming_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_circle_off"
            android:padding="8dp"
            android:src="@drawable/ic_tile_gaming"
            android:tint="@color/widget_icon_off"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_gaming_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_gaming_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_subtext"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_anim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="2dp">

        <ImageView
            android:id="@+id/w_anim_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_circle_off"
            android:padding="8dp"
            android:src="@drawable/ic_tile_animation"
            android:tint="@color/widget_icon_off"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_anim_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_anim_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_subtext"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_refresh"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="2dp">

        <ImageView
            android:id="@+id/w_refresh_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_circle_off"
            android:padding="8dp"
            android:src="@drawable/ic_tile_refresh"
            android:tint="@color/widget_icon_off"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_refresh_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_refresh_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_subtext"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_awake"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="2dp">

        <ImageView
            android:id="@+id/w_awake_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_circle_off"
            android:padding="8dp"
            android:src="@drawable/ic_tile_coffee"
            android:tint="@color/widget_icon_off"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_awake_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_awake_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_subtext"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
